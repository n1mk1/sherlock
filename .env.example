# Sherlock configuration (TRD §10). Copy to .env and fill in. Never commit .env.

# Storage. Without Docker, relative paths resolve from api/ (where uvicorn runs).
# docker compose overrides both to the /data volume (./data on the host).
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/sherlock.db

# Nebius Token Factory (OpenAI-compatible API)
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/
LLM_API_KEY=

# Model roles: LARGE, MEDIUM and SMALL must be Nemotron IDs (Ultra, Super, Nano).
# EMBED is empty (embeddings off) or one of NVIDIA_EMBED_MODELS.
# Filled from the Token Factory catalog by scripts/smoke_llm.py (Implementation Plan D1.2).
MODEL_LARGE=nvidia/Nemotron-3-Ultra-550b-a55b
MODEL_MEDIUM=nvidia/nemotron-3-super-120b-a12b
MODEL_SMALL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_EMBED=
NVIDIA_EMBED_MODELS=
LLM_TOOLS_MODE=native

# Jobs and sandbox
JOB_BACKEND=local
JOB_WORKERS=4
SANDBOX_CPU_S=30
SANDBOX_MEM_MB=2048

# Memory cap of each DuckDB connection (ingest and the per-version query cache)
DUCKDB_MEMORY_MB=1024

# Limits
MAX_UPLOAD_MB=50
MAX_COLUMNS=1000
MAX_ROWS=2000000
USER_STORAGE_MB=500
DATASET_TTL_DAYS=7

# Token budgets
USER_TOKEN_BUDGET=2000000
JOB_TOKEN_BUDGET=300000
MESSAGE_TOKEN_BUDGET=40000

# Cleaner
CLEAN_MAX_STEPS=20
CLEAN_MAX_SECONDS=300

# P1
TAVILY_API_KEY=

NOTEBOOK_PINS=pandas==2.2.3,duckdb==1.1.3,numpy==2.1.3,scikit-learn==1.5.2,statsmodels==0.14.4,matplotlib==3.9.2,rapidfuzz==3.10.1,dateparser==1.2.0,ftfy==6.3.1

# Local dev only (Vite on :5173). Production serves the web app from the API origin.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# The built web app served by the API under / (the image sets /app/web). Empty in local dev.
WEB_DIST_DIR=

# Sandbox daemon socket and temp root; empty in local dev (workers start directly)
SANDBOXD_SOCKET=
SANDBOX_TMP=
