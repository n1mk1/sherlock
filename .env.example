# Sherlock configuration. Copy to .env and fill in. Never commit .env.

# Storage. Without Docker, relative paths resolve from api/ (where uvicorn runs).
# docker compose overrides both to the /data volume (./data on the host).
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/sherlock.db

# Nebius Token Factory (OpenAI-compatible API)
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/
LLM_API_KEY=

# Model roles: LARGE, MEDIUM and SMALL must be Nemotron IDs (Ultra, Super, Nano).
# EMBED is empty (embeddings off) or one of NVIDIA_EMBED_MODELS.
MODEL_LARGE=nvidia/Nemotron-3-Ultra-550b-a55b
MODEL_MEDIUM=nvidia/nemotron-3-super-120b-a12b
MODEL_SMALL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_EMBED=
NVIDIA_EMBED_MODELS=
LLM_TOOLS_MODE=native
# Answer model calls from recorded fixtures (a file or directory) instead of Token Factory; empty = live.
LLM_MOCK=
# Append every live model reply to this fixture file (for recording new fixtures).
LLM_RECORD=
# Model calls of each role in flight at once, across the whole process (one shared gate per role)
LLM_CONCURRENCY_LARGE=2
LLM_CONCURRENCY_MEDIUM=6
LLM_CONCURRENCY_SMALL=4

# Jobs and sandbox
JOB_WORKERS=4
PURGE_INTERVAL_S=600            # the purge job's period in seconds (Schema §6); 0 turns it off
SAMPLE_SEED_DIR=                # the cached sample: empty = the seed in the image, "off" = import it live
SANDBOX_CPU_S=30
SANDBOX_MEM_MB=2048

# Memory cap of each DuckDB connection (ingest and the per-version query cache)
DUCKDB_MEMORY_MB=1024

# Limits
MAX_UPLOAD_MB=50
MAX_COLUMNS=1000
MAX_ROWS=2000000
USER_STORAGE_MB=500
DATASET_TTL_DAYS=7

# Token budgets
USER_TOKEN_BUDGET=2000000
JOB_TOKEN_BUDGET=300000
MESSAGE_TOKEN_BUDGET=40000
# All users together per UTC day (0 = none), and new users per client IP per hour (0 = none)
APP_TOKEN_BUDGET=10000000
NEW_USERS_PER_IP_HOUR=300
# X-Forwarded-For entries the host's own proxies append after the client's (Render: 1)
TRUSTED_PROXY_HOPS=1

# Cleaner
CLEAN_MAX_STEPS=20
CLEAN_MAX_SECONDS=300
# The background severity review; off, every plan item keeps code's default level
CLEAN_REVIEW=on
# Suggested checks, written by the same review job
CLEAN_SUGGEST=on
# Grounding: the review job asks Tavily what the columns mean (column names only, never values), once per
# dataset, up to 9 calls. Needs TAVILY_API_KEY and a model. off: no lookup.
CLEAN_GROUND=on
# Seconds a check of your own may run on a version before it's stopped
RULE_MAX_S=2
# Detector packs: off, all, or a comma-separated allowlist of pack names; and detector ids that don't run
DETECTOR_PLUGINS=off
DETECTORS_OFF=

# Web retrieval through Tavily: search, extract and map only. Empty: every web feature is off
# and says so in one line. WEB_SEARCH=off turns it off even with a key.
TAVILY_API_KEY=
WEB_SEARCH=on
TAVILY_TIMEOUT_S=8
# Tavily calls per user per hour (cache hits don't count); 0 = no cap
WEB_RATE_LIMIT=20
# Answer Tavily calls from recorded responses (a file or directory) instead of the network; empty = live.
WEB_MOCK=

NOTEBOOK_PINS=pandas==2.2.3,duckdb==1.1.3,numpy==2.1.3,scikit-learn==1.5.2,matplotlib==3.9.2,rapidfuzz==3.10.1,dateparser==1.2.0,ftfy==6.3.1

# Local dev only (Vite on :5173). Production serves the web app from the API origin.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# The deployed commit for /healthz. Render sets RENDER_GIT_COMMIT itself, so leave this empty there.
GIT_COMMIT=

# The built web app served by the API under / (the image sets /app/web). Empty in local dev.
WEB_DIST_DIR=

# Sandbox daemon socket and temp root; empty in local dev (workers start directly)
SANDBOXD_SOCKET=
SANDBOX_TMP=
